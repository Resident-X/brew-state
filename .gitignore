# Staircase derived indexes (rebuilt from specs/ via `task sc:index`), together
# with the SQLite write-ahead sidecars that appear beside them while the engine
# holds the index open
.staircase/*.db
.staircase/*.db-shm
.staircase/*.db-wal
# External embedder model asset (machine-global cache, wired by `task sc:embed`)
.staircase/models
# staircase binary — installed repo-locally via `task sc:install` (go install from source)
/engine/
# macOS
.DS_Store

# Transient apply lock
specs/.staircase-apply.lock

# PlatformIO build tree and the compilation database the seam's checks generate
firmware/.pio/
firmware/compile_commands.json

# Python bytecode from the firmware check scripts
__pycache__/

# External tooling the emulation tier fetches and pins by digest rather than
# carries: the emulator itself, and the vendor's register description, whose
# licence this repository does not hold. Provisioned by `task fw:emulate:provision`.
/.tooling/
