# The correction_read_only_fixture structure's two coefficients.
#
# This structure describes no machine and neither number below means anything.
# They exist so an artefact built against this structure can be run at all,
# which is what lets the exclusivity check compare a sixth real artefact
# against the others: the first gives admission's probes a value to read back,
# and the second is what lets the one actuation channel this structure answers
# actually move something over the host exercise's plant-only steps.
#
# The statement below is that same fact in the form the check reads, and it is
# what exempts this description from accounting for its values. A number that
# means nothing has no origin to record.

@describes-no-machine

outlet.value_c = 21.5
heater.gain = 2.5
