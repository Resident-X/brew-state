# The same description as thermoblock-nominal.params with one coefficient
# changed: brew.heater_power_w is 1600 rather than 1200.
#
# It exists so that one linked executable can be run against both and produce
# two different trajectories with no rebuild between the runs. A coefficient
# quietly written into the equations rather than read from here would give the
# same trajectory twice, which is exactly what that check fails on. Like the
# nominal description, these values describe no machine.

ambient_temperature_c = 20.0

brew.thermal_mass_j_per_k = 420.0
brew.heater_power_w = 1600.0
brew.loss_w_per_k = 1.5

steam.thermal_mass_j_per_k = 900.0
steam.heater_power_w = 1400.0
steam.loss_w_per_k = 2.2

pump.pressure_bar = 9.0
brew.pressure_time_constant_s = 0.8

steam.saturation_temperature_c = 100.0
steam.pressure_bar_per_k = 0.035
