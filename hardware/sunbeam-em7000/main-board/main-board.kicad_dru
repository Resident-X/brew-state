(version 1)
# Every rule here has its row, figure and source in design-rules.md beside this file.
(rule "Mains separation"
	(condition "A.hasNetclass('Mains') && !B.hasNetclass('Mains')")
	(constraint clearance (min 3mm))
	(constraint creepage (min 10mm)))
(rule "MainsTrunk track width"
	(condition "A.hasNetclass('MainsTrunk')")
	(constraint track_width (min 4.2mm)))
(rule "MainsBranch track width"
	(condition "A.hasNetclass('MainsBranch')")
	(constraint track_width (min 0.2mm)))
(rule "Supply5V track width"
	(condition "A.hasNetclass('Supply5V')")
	(constraint track_width (min 0.45mm)))
(rule "Supply3V3 track width"
	(condition "A.hasNetclass('Supply3V3')")
	(constraint track_width (min 0.2mm)))
(rule "Ground track width"
	(condition "A.hasNetclass('Ground')")
	(constraint track_width (min 0.45mm)))
(rule "Corners"
	(constraint track_angle (min 135)))
(rule "Jogs"
	(constraint track_segment_length (min 1mm)))
(rule "Ground pad reliefs"
	(condition "A.Type == 'Pad' && A.hasNetclass('Ground') && !(A.Reference == 'U620' && A.Pad_Number == '21') && !(A.Reference == 'U621' && A.Pad_Number == '21') && !(A.Reference == 'U302' && A.Pad_Number == '2')")
	(constraint zone_connection thermal_reliefs))
(rule "Plated hole spacing"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Pad' && B.Pad_Type == 'Through-hole'")
	(constraint hole_to_hole (min 1.5mm)))
